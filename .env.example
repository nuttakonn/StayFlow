# StayFlow PMS - Local Development Environment Variables
# Copy to .env for local overrides (never commit .env to source control)

# Deployment Configuration
DEPLOYMENT_MODE=SaaS
# Options: SaaS, OnPremise

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stayflow_db
POSTGRES_USER=stayflow_app
POSTGRES_PASSWORD=stayflow_dev_password_change_in_prod

# Connection String (Local development default)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=stayflow_db;Username=stayflow_app;Password=stayflow_dev_password_change_in_prod;

# Rate Limiting (optional — defaults shown)
# AuthPermitLimit: login/register requests per IP per minute
# ApiPermitLimit: authenticated API requests per user per minute
RateLimiting__AuthPermitLimit=20
RateLimiting__ApiPermitLimit=300

# Reverse Proxy (on-premise with nginx/Caddy in front of Kestrel)
# Without these, X-Forwarded-For is ignored and RemoteIpAddress is used directly.
# List your proxy's IP(s) so the real client IP is used for per-IP rate limiting.
# Example single proxy:  ReverseProxy__KnownProxies__0=192.168.1.1
# Example CIDR network:  ReverseProxy__KnownNetworks__0=10.0.0.0/8
# Leave blank for direct Kestrel (dev, Docker without a proxy layer).
# ReverseProxy__KnownProxies__0=
# ReverseProxy__KnownNetworks__0=

# Frontend
VITE_API_BASE_URL=http://localhost:5000
